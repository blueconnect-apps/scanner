# Kopieer dit bestand naar .env en vul de waarden in.
#
# Let op: alles met VITE_ komt leesbaar in de gebouwde JavaScript terecht en is dus
# openbaar. Zet hier nooit geheimen (API-sleutels, wachtwoorden) in.

# Basis-URL van de n8n-webhooks, zonder slash aan het eind. Moet https zijn
# (http mag alleen voor localhost).
VITE_API_BASE_URL=url-van-je-n8n-webhooks

# Naam waaronder het sessietoken op het toestel wordt bewaard (localStorage). Letters, cijfers,
# punt, streepje en underscore. Wijzigen betekent dat elk toestel de scanner opnieuw vanuit
# AFAS InSite moet openen.
VITE_TOKEN_STORAGE_KEY=geheime-sleutel-voor-token

# Na hoeveel milliseconden een verzoek naar n8n als mislukt geldt (1000 tot 120000), zodat de
# scanner niet blijft hangen op 'Bezig…'.
VITE_API_TIMEOUT_MS=15000
